<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store build (scripts/build-appstore.sh fills in @TEAM_ID@) -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- database servers -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- databases, certificates, imports and exports picked in file dialogs -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- keep access to those files across launches -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>@TEAM_ID@.dev.navdb.studio</string>
	<key>com.apple.developer.team-identifier</key>
	<string>@TEAM_ID@</string>
</dict>
</plist>
